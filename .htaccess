<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes +FollowSymLinks
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Do not proxy .well-known
    RewriteCond %{REQUEST_URI} ^/\.well-known/
    RewriteRule ^ - [L]

    # Serve existing static files directly (including /storage symlink)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Backend API v1 & sanctum -> route to Laravel backend/public/index.php
    RewriteCond %{REQUEST_URI} ^/api/v1/ [OR]
    RewriteCond %{REQUEST_URI} ^/sanctum/
    RewriteRule ^ backend/public/index.php [L]

    # Reverse Proxy all web routes & Next.js API to Next.js (Port 3040)
    RewriteRule ^(.*)$ http://127.0.0.1:3040/$1 [P,L]
</IfModule>
